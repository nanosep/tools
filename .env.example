# ============================================
# ClarityCrew Tools - Environment Configuration
# ============================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env:
#    - Windows: copy .env.example .env
#    - macOS/Linux: cp .env.example .env
#
# 2. Get your API key from: https://console.anthropic.com/
#
# 3. Replace 'your_api_key_here' with your actual key below
#
# 4. IMPORTANT: Never commit the .env file to version control
#    (it's already in .gitignore)
#
# ============================================

# Anthropic API Configuration
# Format: sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ANTHROPIC_API_KEY=your_api_key_here

# ============================================
# NOTES:
# - The application uses model: claude-sonnet-4-20250514
# - Rate limiting: 1-second delays between sequential API calls
# - API usage varies by tool (see README.md for details)
# ============================================
